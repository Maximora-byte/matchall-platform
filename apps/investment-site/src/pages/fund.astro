---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="基金净值 · OpenClaw Investment" description="OCIX 基金净值、历史走势、区间数据与风险摘要。" path="/fund/"><section class="page-hero shell fund-head"><div><p class="eyebrow">Fund NAV</p><h1>基金净值</h1><p class="lede">查看 OCIX 的公开净值走势与风险摘要。数据质量不满足门槛时，页面会明确停止展示可能误导的指标。</p></div><aside class="quote" aria-live="polite" aria-busy="true"><div class="quote-top"><span class="data-status" id="live"><i></i><span>正在读取数据</span></span><time id="updated">--</time></div><div class="quote-value" id="current">--</div><div class="quote-change" id="change">等待更新</div><dl><div><dt>净值 NAV</dt><dd id="nav">--</dd></div><div><dt>初始基准</dt><dd id="baseline">--</dd></div></dl></aside></section><section class="section shell"><div class="section-title"><div><p class="eyebrow">Performance</p><h2>净值走势</h2></div><div class="range" aria-label="图表时间范围"><button data-range="7">7D</button><button data-range="30">1M</button><button data-range="90" class="active">3M</button><button data-range="0">全部</button></div></div><div class="chart-shell"><div id="chart" role="img" aria-label="OCIX K 线走势图"></div><div class="chart-empty" id="chartEmpty">正在载入走势图…</div></div></section><section class="section shell"><div class="section-title"><div><p class="eyebrow">Snapshot</p><h2>区间概览</h2></div><span id="riskQuality">正在校验样本</span></div><div class="metrics"><article class="metric-card"><small>区间最高</small><strong id="high">--</strong></article><article class="metric-card"><small>区间最低</small><strong id="low">--</strong></article><article class="metric-card"><small>当前回撤</small><strong id="drawdown">--</strong></article></div></section><section class="section shell"><div class="section-title"><div><p class="eyebrow">Risk</p><h2>风险摘要</h2></div></div><div class="metrics"><article class="metric-card"><small>样本期收益</small><strong id="periodReturn">--</strong></article><article class="metric-card"><small>最大回撤</small><strong id="maxDrawdown">--</strong></article><article class="metric-card"><small>年化波动率</small><strong id="volatility">--</strong></article></div><p class="disclosure" id="riskMethod">风险指标仅在时间序列连续性和变化样本满足门槛时展示。</p></section><script>
import{createChart,CandlestickSeries,ColorType}from'lightweight-charts';import type{IChartApi,ISeriesApi,CandlestickData,UTCTimestamp}from'lightweight-charts';type Candle={ts:string;open:number|string;high:number|string;low:number|string;close:number|string};const $=<T extends HTMLElement>(s:string)=>document.querySelector<T>(s)!;const num=(v:unknown,f=0)=>Number.isFinite(Number(v))?Number(v):f;const money=new Intl.NumberFormat('zh-CN',{style:'currency',currency:'USD',maximumFractionDigits:2});let candles:Candle[]=[];let activeRange=90;let chart:IChartApi|undefined;let series:ISeriesApi<'Candlestick'>|undefined;function colors(){return matchMedia('(prefers-color-scheme: light)').matches?{bg:'#fff',text:'#65766e',line:'#d8e4de'}:{bg:'#0d1814',text:'#93a99f',line:'#243a31'}}function selected(){return activeRange?candles.slice(-activeRange):candles}function render(){if(!series||!chart)return;const data:CandlestickData<UTCTimestamp>[]=selected().map(c=>({time:Math.floor(new Date(c.ts).getTime()/1000)as UTCTimestamp,open:num(c.open),high:num(c.high),low:num(c.low),close:num(c.close)}));series.setData(data);if(data.length){chart.timeScale().fitContent();$('#chartEmpty').hidden=true;const peak=Math.max(...data.map(c=>c.high)),low=Math.min(...data.map(c=>c.low)),last=data.at(-1)!.close;$('#high').textContent=peak.toFixed(2);$('#low').textContent=low.toFixed(2);$('#drawdown').textContent=`${((last/peak-1)*100).toFixed(2)}%`}else $('#chartEmpty').textContent='暂无可用走势数据'}function init(){const c=colors();chart?.remove();chart=createChart($('#chart'),{autoSize:true,height:438,layout:{background:{type:ColorType.Solid,color:c.bg},textColor:c.text},grid:{vertLines:{color:c.line},horzLines:{color:c.line}},rightPriceScale:{borderColor:c.line},timeScale:{borderColor:c.line}});series=chart.addSeries(CandlestickSeries,{upColor:'#42b883',downColor:'#ef6677',borderUpColor:'#42b883',borderDownColor:'#ef6677',wickUpColor:'#42b883',wickDownColor:'#ef6677'});render()}function risk(payload:any){const r=payload?.risk||{},ok=r.quality==='ok';$('#riskQuality').textContent=ok?`${num(r.observations)} 个日样本 · 口径有效`:`${num(r.observations)} 个日样本 · 暂不展示`;$('#periodReturn').textContent=ok?`${num(r.period_return_pct).toFixed(2)}%`:'样本不足';$('#maxDrawdown').textContent=ok?`${num(r.max_drawdown_pct).toFixed(2)}%`:'样本不足';$('#volatility').textContent=ok?`${num(r.annualized_volatility_pct).toFixed(2)}%`:'样本不足';$('#riskMethod').textContent=ok?'基于每日收盘收益率计算，波动率按 365 日年化。':'当前序列存在大尺度跳变或有效变化天数不足，系统已阻止展示可能误导的收益、回撤和波动率。'}async function load(){const ctrl=new AbortController(),timer=setTimeout(()=>ctrl.abort(),5000);try{const[a,b]=await Promise.all([fetch('/api/index',{cache:'no-store',signal:ctrl.signal}),fetch('/api/risk',{cache:'no-store',signal:ctrl.signal})]);if(!a.ok)throw Error();const idx=await a.json();candles=Array.isArray(idx.candles)?idx.candles:[];const s=idx.stats||{},d=num(s.change),up=d>=0;$('#current').textContent=num(s.current).toFixed(2);$('#change').className=`quote-change ${up?'up':'down'}`;$('#change').textContent=`${up?'上涨':'下跌'} ${Math.abs(d).toFixed(2)} · ${up?'+':''}${num(s.change_pct).toFixed(2)}%`;$('#nav').textContent=money.format(num(idx.nav));$('#baseline').textContent=money.format(num(idx.baseline));const t=idx.updated?new Date(idx.updated):null,stale=!t||Date.now()-t.getTime()>180000;$('#updated').textContent=t?t.toLocaleString('zh-CN'):'更新时间未知';$('#live').className=`data-status ${stale?'error':'ok'}`;$('#live span').textContent=stale?'数据可能已过期':'数据已更新';render();risk(b.ok?await b.json():null)}catch{$('#live').className='data-status error';$('#live span').textContent='数据暂不可用';$('#chartEmpty').textContent='走势图暂不可用';risk(null)}finally{clearTimeout(timer);document.querySelector('.quote')?.setAttribute('aria-busy','false')}}document.querySelectorAll<HTMLButtonElement>('[data-range]').forEach(x=>x.addEventListener('click',()=>{activeRange=num(x.dataset.range);document.querySelectorAll('[data-range]').forEach(b=>b.classList.toggle('active',b===x));render()}));init();load();setInterval(()=>{if(!document.hidden)load()},30000);matchMedia('(prefers-color-scheme: light)').addEventListener('change',init);
</script></BaseLayout>
