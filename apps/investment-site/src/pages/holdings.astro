---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="公开持仓 · OpenClaw Investment" description="OpenClaw Investment 当前公开持仓与数据边界说明。" path="/holdings/"><section class="page-hero shell"><p class="eyebrow">Public Holdings</p><h1>公开持仓</h1><p class="lede">展示后端明确允许公开的当前仓位摘要。页面不包含账户标识、订单入口、密钥、完整数量或私有交易流水。</p></section><section class="section shell"><div class="section-title"><div><p class="eyebrow">Live positions</p><h2>当前仓位</h2></div><span class="data-status" id="status"><i></i><span>正在读取</span></span></div><div class="positions-grid" id="positions"><div class="empty">正在读取公开持仓…</div></div><div class="disclosure">持仓信息按公开接口原样呈现，可能受交易所维护、接口延迟和标记价格变化影响。内容仅供信息展示，不构成投资建议。</div></section><script>
type Position={upl:number|string;instId:string;posSide:string;lever:number|string;avgPx:number|string;markPx:number|string};const $=<T extends HTMLElement>(s:string)=>document.querySelector<T>(s)!;const num=(v:unknown)=>Number.isFinite(Number(v))?Number(v):0;const money=new Intl.NumberFormat('zh-CN',{style:'currency',currency:'USD',maximumFractionDigits:2});const entities:Record<string,string>={'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'};const esc=(v:unknown)=>String(v??'').replace(/[&<>'"]/g,c=>entities[c]??c);function render(items:Position[]){$('#status').className='data-status ok';$('#status span').textContent=`${items.length} 项公开持仓`;$('#positions').innerHTML=items.length?items.map(p=>{const pnl=num(p.upl),up=pnl>=0;return`<article class="position"><div class="position-head"><strong>${esc(p.instId)}</strong><span>${p.posSide==='short'?'做空':'做多'}</span></div><dl><div><dt>杠杆</dt><dd>${esc(p.lever)}x</dd></div><div><dt>方向</dt><dd>${p.posSide==='short'?'空':'多'}</dd></div><div><dt>开仓价</dt><dd>${money.format(num(p.avgPx))}</dd></div><div><dt>标记价</dt><dd>${money.format(num(p.markPx))}</dd></div></dl><div class="pnl ${up?'up':'down'}"><span>浮动盈亏</span><strong>${up?'+':''}${money.format(pnl)}</strong></div></article>`}).join(''):'<div class="empty"><strong>当前没有公开持仓</strong><br/>这可能表示当前无持仓，或公开接口未返回可展示内容。</div>'}async function load(){const ctrl=new AbortController(),timer=setTimeout(()=>ctrl.abort(),5000);try{const r=await fetch('/api/positions',{cache:'no-store',signal:ctrl.signal});if(!r.ok)throw Error();const d=await r.json();render(Array.isArray(d.positions)?d.positions:[])}catch{$('#status').className='data-status error';$('#status span').textContent='数据暂不可用';$('#positions').innerHTML='<div class="empty">无法读取公开持仓。页面不会使用旧数据冒充实时结果。</div>'}finally{clearTimeout(timer)}}load();setInterval(()=>{if(!document.hidden)load()},30000);
</script></BaseLayout>
