];
---
<!doctype html>
<html lang="zh-CN"><head>
	<meta charset="utf-8"><meta name="viewport" content="width=device-width">
	<meta name="theme-color" content="#f6f7fa" media="(prefers-color-scheme:light)"><meta name="theme-color" content="#090a0c" media="(prefers-color-scheme:dark)">
	<link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"><link rel="manifest" href="/site.webmanifest"><link rel="stylesheet" href="/brand-icon.css?v=1">
	<title>MatchAll Console · 统一服务控制台</title><meta name="description" content="统一查看 MatchAll 服务、通知与账户连接状态。"><link rel="canonical" href="https://console.maximoraverse.org/">
	<meta property="og:type" content="website"><meta property="og:site_name" content="MatchAll"><meta property="og:title" content="MatchAll Console · 统一服务控制台"><meta property="og:description" content="集中查看服务状态、账户连接与通知偏好。"><meta property="og:url" content="https://console.maximoraverse.org/"><meta property="og:image" content="https://www.maximoraverse.org/assets/brand/matchall-social-1200x630.png"><meta name="twitter:card" content="summary_large_image">
	<script is:inline type="application/ld+json">{"@context":"https://schema.org","@type":"WebApplication","name":"MatchAll Console","url":"https://console.maximoraverse.org/","applicationCategory":"BusinessApplication","operatingSystem":"Web"}</script>
	<style>
		:root{color-scheme:light dark;--bg:#f6f7fa;--card:#fff;--text:#171a21;--muted:#697180;--line:#dce1e8;--accent:#2563eb}*{box-sizing:border-box}body{margin:0;font:16px/1.65 system-ui,sans-serif;background:radial-gradient(circle at 80% 0,#dbeafe,transparent 35%),var(--bg);color:var(--text)}main{max-width:1080px;margin:auto;padding:24px}.skip{position:fixed;left:1rem;top:1rem;z-index:999;transform:translateY(-200%);padding:.7rem 1rem;border-radius:.7rem;background:var(--text);color:var(--bg)}.skip:focus{transform:none}:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.nav{display:flex;justify-content:space-between;align-items:center}.brand{font-weight:800}.hero{padding:14vh 0 8vh;max-width:760px}h1{font-size:clamp(2.7rem,8vw,5.5rem);line-height:1;margin:.2em 0}.lead{font-size:1.15rem;color:var(--muted)}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{min-height:44px;display:inline-flex;align-items:center;padding:.8rem 1.1rem;border:1px solid var(--line);border-radius:999px;color:inherit;text-decoration:none;background:var(--card)}.primary{background:var(--text);color:var(--bg)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{padding:24px;border:1px solid var(--line);border-radius:20px;background:color-mix(in srgb,var(--card) 88%,transparent)}.card p{color:var(--muted)}footer{padding:60px 0 24px;color:var(--muted)}@media(max-width:700px){.grid{grid-template-columns:1fr}.hero{padding-top:10vh}}@media(prefers-color-scheme:dark){:root{--bg:#090a0c;--card:#111318;--text:#f4f5f7;--muted:#9ba3b0;--line:#272b33;--accent:#60a5fa}body{background:radial-gradient(circle at 80% 0,#172554,transparent 35%),var(--bg)}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
	</style>
</head><body><a class="skip" href="#main">跳到正文</a><main id="main"><nav class="nav"><span class="brand"><img src="/icon-192.png" width="36" height="36" alt="">MatchAll Console</span><a class="btn" href="https://www.maximoraverse.org/">全部服务</a></nav><section class="hero"><small>UNIFIED SERVICE CONSOLE</small><h1>一个入口，连接所有服务。</h1><p class="lead">查看服务状态、账户连接与通知偏好。业务数据仍由原控制台安全处理。</p><div class="actions"><a class="btn primary" href="/console">打开控制台</a><a class="btn" href="/login">登录账户</a></div></section><section class="grid" aria-label="控制台能力">{services.map(([name,desc])=><article class="card"><h2>{name}</h2><p>{desc}</p></article>)}</section><footer>© 2026 MatchAll · Console</footer></main></body></html>
