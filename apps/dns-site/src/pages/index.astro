---
const items = [
	["加密传输", "支持 DoH、DoT 与 DoQ 接入。"],
	["策略过滤", "广告、恶意域名与自定义规则在解析前处理。"],
	["分地域解析", "国内与国际使用独立健康路由，并保留最终回退。"],
];
---
<!doctype html>
<html lang="zh-CN"><head>
	<meta charset="utf-8"><meta name="viewport" content="width=device-width">
	<meta name="theme-color" content="#f4f8f7" media="(prefers-color-scheme:light)"><meta name="theme-color" content="#07100e" media="(prefers-color-scheme:dark)">
	<title>MatchAll DNS · 加密隐私解析</title><meta name="description" content="支持加密传输、过滤和分地域路由的隐私 DNS 服务。"><link rel="canonical" href="https://dns.maximoraverse.org/">
	<meta property="og:type" content="website"><meta property="og:site_name" content="MatchAll"><meta property="og:title" content="MatchAll DNS · 加密隐私解析"><meta property="og:description" content="统一加密入口、过滤策略和健康路由。"><meta property="og:url" content="https://dns.maximoraverse.org/"><meta property="og:image" content="https://www.maximoraverse.org/assets/brand/matchall-social-1200x630.png"><meta name="twitter:card" content="summary_large_image">
	<script is:inline type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"MatchAll DNS","url":"https://dns.maximoraverse.org/","serviceType":"Encrypted DNS service"}</script>
	<style>
		:root{color-scheme:light dark;--bg:#f4f8f7;--card:#fff;--text:#14201d;--muted:#61716c;--line:#d4e1dd;--accent:#0f9f7a}*{box-sizing:border-box}body{margin:0;font:16px/1.65 system-ui,sans-serif;background:radial-gradient(circle at 15% 0,#ccfbf1,transparent 34%),var(--bg);color:var(--text)}main{max-width:1080px;margin:auto;padding:24px}.skip{position:fixed;left:1rem;top:1rem;z-index:999;transform:translateY(-200%);padding:.7rem 1rem;border-radius:.7rem;background:var(--text);color:var(--bg)}.skip:focus{transform:none}:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.nav{display:flex;justify-content:space-between;align-items:center}.brand{font-weight:800}.hero{padding:14vh 0 8vh;max-width:800px}h1{font-size:clamp(2.8rem,8vw,5.6rem);line-height:1;margin:.2em 0}.lead{color:var(--muted);font-size:1.15rem}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.btn{min-height:44px;display:inline-flex;align-items:center;padding:.8rem 1.1rem;border:1px solid var(--line);border-radius:999px;color:inherit;text-decoration:none;background:var(--card)}.primary{background:var(--text);color:var(--bg)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{padding:24px;border:1px solid var(--line);border-radius:20px;background:color-mix(in srgb,var(--card) 88%,transparent)}.card p{color:var(--muted)}footer{padding:60px 0 24px;color:var(--muted)}@media(max-width:700px){.grid{grid-template-columns:1fr}.hero{padding-top:10vh}}@media(prefers-color-scheme:dark){:root{--bg:#07100e;--card:#0d1815;--text:#eefbf7;--muted:#94aaa3;--line:#20352f;--accent:#5ee0b7}body{background:radial-gradient(circle at 15% 0,#064e3b,transparent 34%),var(--bg)}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
		.brand{display:flex;align-items:center;gap:12px;color:inherit;text-decoration:none}.brand img{display:block;width:42px;height:42px;flex:0 0 auto}.brand-copy{display:block;font-size:16px;font-weight:800;line-height:1.12;letter-spacing:-.025em}.brand-copy small{display:block;margin-top:4px;color:var(--muted);font-size:9px;font-weight:750;line-height:1.12;letter-spacing:.16em;text-transform:uppercase}
	</style>
</head><body><a class="skip" href="#main">跳到正文</a><main id="main"><nav class="nav"><a class="brand" href="/" aria-label="MatchAll DNS 首页"><img src="/static/brand/matchall-symbol.svg" alt="" width="42" height="42"><span class="brand-copy">MatchAll DNS<small>Private DNS gateway</small></span></a><a class="btn" href="https://status.maximoraverse.org/">服务状态</a></nav><section class="hero"><small>PRIVATE DNS GATEWAY</small><h1>更安静，也更可靠的解析。</h1><p class="lead">统一加密入口、过滤策略、健康切换与可观测能力。账户数据继续由原 DNS Portal 安全提供。</p><div class="actions"><a class="btn primary" href="/account">进入账户</a><a class="btn" href="/guide">配置指南</a></div></section><section class="grid" aria-label="DNS 服务能力">{items.map(([name,desc])=><article class="card"><h2>{name}</h2><p>{desc}</p></article>)}</section><footer>© 2026 MatchAll · DNS</footer></main></body></html>
